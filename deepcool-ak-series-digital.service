[Unit]
Description=Displaying the current temperature and utilization on the Deepcool AK Series CPU cooler

[Service]
Type=simple
User=root
# Edit the flags below for your hardware before installing this unit.
# Defaults shown: AK620, k10temp sensor, temp + utilization both shown, 2s interval.
# Run `cooler-display --help` for the full list of options, e.g.:
#   --model ak500s --sensor <your-sensor> --disable-utils --interval 3
ExecStart=/usr/local/bin/cooler-display --model ak620 --sensor k10temp
Restart=always

[Install]
WantedBy=default.target
